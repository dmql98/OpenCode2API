{
  "name": "opencode2api",
  "version": "3.0.0",
  "description": "Local / LAN OpenAI-compatible gateway for OpenCode, with a built-in WebUI console.",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest tests/unit --runInBand --detectOpenHandles",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest tests/unit --runInBand --detectOpenHandles",
    "test:stream": "bash tests/manual/test-streaming-real.sh"
  },
  "keywords": [
    "opencode",
    "openai",
    "gateway",
    "proxy",
    "webui",
    "lan",
    "local",
    "ai",
    "api"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@opencode-ai/sdk": "^1.1.51",
    "body-parser": "^1.20.3",
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "jest": "^30.2.0",
    "supertest": "^7.2.2"
  }
}
